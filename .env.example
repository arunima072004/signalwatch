# SignalWatch environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------------
# Search provider
# -----------------------------------------------------------------------
# Which provider to use: mock | tavily | cached
# "mock"   - no API calls, uses canned results (testing/CI)
# "tavily" - live Tavily API (requires TAVILY_API_KEY)
# "cached" - disk-backed cache (uses data/search_cache/*.json);
#            falls back to Tavily if cache misses and TAVILY_API_KEY is set
SEARCH_PROVIDER=mock

# Tavily API key — get yours at https://app.tavily.com (free tier: 1,000 credits/month)
TAVILY_API_KEY=tvly-your-key-here

# Tavily search depth: "basic" (1 credit/query) or "advanced" (2 credits/query)
# "basic" is recommended for the 24-event historical run (375 queries = 375 credits)
TAVILY_SEARCH_DEPTH=basic
